{
  "name": "uniapp-delivery-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Uni-app delivery ops minimal e2e automation setup",
  "scripts": {
    "serve:mock-api": "node server/mock-api/index.mjs",
    "serve:h5:local": "node scripts/serve-h5-local.js",
    "build:h5": "node scripts/h5-build.js --env production",
    "preview:h5": "node scripts/serve-h5-local.js",
    "preflight:h5:staging": "node scripts/h5-preflight.js --env staging",
    "preflight:h5:production": "node scripts/h5-preflight.js --env production",
    "deploy:staging": "node scripts/h5-deploy.js --env staging",
    "deploy:production": "node scripts/h5-deploy.js --env production",
    "canary:website": "node scripts/website-canary-acceptance.js",
    "test:e2e": "jest --runInBand",
    "test:e2e:result:local-h5": "set PLAYWRIGHT_BROWSERS_PATH=.ms-playwright&& jest --config jest.h5.local.config.js --runInBand tests/result/approve-result.spec.js tests/result/mark-needs-revision.spec.js",
    "test:e2e:result": "jest --runInBand tests/result/approve-result.spec.js",
    "test:e2e:batch": "jest --runInBand tests/batch-detail/approve-deliverable-results.spec.js",
    "test:e2e:project": "jest --runInBand tests/project-detail/approve-deliverable-batches-in-project.spec.js",
    "test:playwright:h5-smoke": "node tests/playwright/h5-smoke.spec.js",
    "test:playwright:result-smoke": "node tests/playwright/result-smoke.spec.js",
    "test:playwright:result-needs-revision-smoke": "node tests/playwright/result-needs-revision-smoke.spec.js",
    "test:playwright:smoke-all": "node tests/playwright/run-smokes.js",
    "test:playwright:result-share-click-smoke": "node tests/playwright/result-share-click-smoke.spec.js",
    "smoke:provider-contract": "node scripts/smoke/provider-contract-smoke.js",
    "smoke:generation-loop": "node scripts/full-generation-loop-smoke.js",
    "smoke:detail-long-image": "node scripts/detail-long-image-entry-smoke.js",
    "smoke:detail-page-renderer": "node scripts/detail-page-renderer-smoke.js",
    "smoke:detail-content-organizer": "node scripts/detail-content-organizer-smoke.js",
    "smoke:detail-page-full-chain": "node scripts/detail-page-full-chain-smoke.js",
    "smoke:product-profile": "node scripts/product-profile-smoke.js",
    "smoke:detail-sku-batch": "node scripts/detail-sku-batch-smoke.js",
    "test:regression:core": "node scripts/regression-core-v1.js",
    "smoke:observability": "node scripts/observability-alerting-smoke.js",
    "smoke:release-control": "node scripts/release-control-smoke.js",
    "smoke:privacy-compliance": "node scripts/privacy-compliance-smoke.js",
    "audit:security-baseline": "node scripts/security-baseline-audit.js",
    "smoke:incident-continuity": "node scripts/incident-continuity-smoke.js",
    "smoke:business-metrics": "node scripts/business-metrics-smoke.js",
    "smoke:product-roadmap": "node scripts/product-roadmap-smoke.js",
    "smoke:v1-readiness": "node scripts/v1-readiness-smoke.js",
    "audit:mp-package": "node scripts/mp-package-audit.js --allow-stale",
    "preflight:mp-package": "node scripts/mp-package-audit.js"
  },
  "devDependencies": {
    "@dcloudio/uni-automator": "2.0.2-5000720260410001",
    "@dcloudio/uni-h5": "^2.0.2-5000720260410001",
    "@dcloudio/vue-cli-plugin-uni": "^2.0.2-5000720260410001",
    "fs-extra": "^11.3.4",
    "jest": "27.5.1",
    "merge": "^2.1.1",
    "playwright": "^1.59.1"
  }
}
